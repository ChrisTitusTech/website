---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import PostList from "../components/PostList.astro";
import { getAllPosts, getPublishedPosts, homepagePosts, taxonomy } from "../lib/content";
import livestreams from "../../data/livestreams.json";

const allPosts = await getAllPosts();
const posts = await getPublishedPosts();
const featured = homepagePosts(allPosts);
const featuredImage = featured[0]?.data.image ? `/${featured[0].data.image.replace(/^\//, "")}` : undefined;
const topics = [...taxonomy(posts, "categories").entries()]
  .map(([slug, group]) => ({ slug, name: group.name, count: group.posts.length }))
  .sort((left, right) => right.count - left.count || left.name.localeCompare(right.name))
  .slice(0, 8);
const recentStreams = livestreams.items.filter((stream) => /^[A-Za-z0-9_-]{6,16}$/.test(stream.videoId)).slice(0, 3);
---
<BaseLayout preloadImage={featuredImage} feed="/index.xml">
  <section class="home-hero container">
    <p class="eyebrow">Independent tech guides</p>
    <h1>Make your technology work for you.</h1>
    <p class="lede">
      Practical Linux, Windows, networking, software development, and open-source guidance from Chris Titus Tech.
    </p>
  </section>
  <section class="container home-featured" aria-labelledby="featured-heading">
    <h2 id="featured-heading">Featured</h2>
    <div class="grid post-grid">
      {featured.map((post, index) => <PostCard post={post} heading="h3" priority={index === 0} />)}
    </div>
  </section>
  <section class="container home-latest" aria-labelledby="latest-heading">
    <h2 id="latest-heading">Latest articles</h2>
    <PostList posts={posts.slice(0, 8)} heading="h3" />
    <p class="home-latest-cta"><a class="btn" href="/posts/">Browse all articles <span aria-hidden="true">→</span></a></p>
  </section>
  <section class="container home-topics" aria-labelledby="topics-heading">
    <h2 id="topics-heading">Explore topics</h2>
    <div class="chips">
      {topics.map((topic) => (
        <a class="chip" href={`/categories/${topic.slug}/`}>
          {topic.name} ({topic.count})
        </a>
      ))}
    </div>
  </section>
  <section class="container home-streams" aria-labelledby="streams-heading">
    <p class="eyebrow">From the studio</p>
    <h2 id="streams-heading">Recent live streams</h2>
    <div class="grid stream-grid">
      {recentStreams.map((stream) => (
        <article class="card card-link">
          <a href={`/live-streams/player/?v=${stream.videoId}`} aria-hidden="true" tabindex="-1">
            <img src={stream.thumbnail} width="640" height="360" loading="lazy" alt="" />
          </a>
          <div class="card-body">
            <h3><a href={`/live-streams/player/?v=${stream.videoId}`}>{stream.title}</a></h3>
            <p class="meta">{stream.date}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="home-streams-cta"><a class="btn" href="/live-streams/">View the archive <span aria-hidden="true">→</span></a></p>
  </section>
  <section class="container home-creator-hub" aria-labelledby="creator-heading">
    <p class="eyebrow">Creator hub</p>
    <h2 id="creator-heading">Put the guides to work</h2>
    <div class="grid home-creator-grid">
      <article class="card">
        <div class="card-body">
          <h3>Downloads</h3>
          <p>Get scripts, utilities, and digital resources.</p>
          <a href="/downloads/">Browse downloads <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="card">
        <div class="card-body">
          <h3>Live</h3>
          <p>Watch recent recordings with synchronized chat replay.</p>
          <a href="/live-streams/">Open the archive <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="card">
        <div class="card-body">
          <h3>Recommendations</h3>
          <p>See the hardware and services Chris uses.</p>
          <a href="/recommendations/">View recommendations <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="card">
        <div class="card-body">
          <h3>Community</h3>
          <p>Ask questions and share what you are building.</p>
          <a href="https://forum.christitus.com/">Visit the forums <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
  </section>
  <section class="container home-newsletter" aria-labelledby="newsletter-heading">
    <div class="card">
      <div class="card-body">
        <p class="eyebrow">Stay current</p>
        <h2 id="newsletter-heading">Newsletter and YouTube</h2>
        <p>Get the latest guides, livestreams, and independent takes on technology.</p>
        <p>
          <a href="/newsletter/">Join the newsletter</a> · <a href="https://youtube.com/@christitustech">Watch on YouTube</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .home-hero {
    padding-top: clamp(1.75rem, 5vw, 4rem);
    padding-bottom: clamp(1.25rem, 4vw, 3rem);
  }
  .home-topics,
  .home-streams,
  .home-creator-hub,
  .home-newsletter {
    padding-block: clamp(1.25rem, 4vw, 3rem);
  }
  .home-latest-cta,
  .home-streams-cta {
    text-align: right;
  }
  .home-creator-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
  }
</style>
