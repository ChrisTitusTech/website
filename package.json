{
  "name": "christitus-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare-content.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:content": "node scripts/dev.mjs --preview",
    "sync": "npm run prepare:content && astro sync",
    "check": "npm run prepare:content && astro check",
    "build": "CONTENT_PREVIEW=0 npm run prepare:content && CONTENT_PREVIEW=0 astro build",
    "preview": "ASTRO_PREVIEW_BACKGROUND=0 astro preview",
    "test": "CONTENT_PREVIEW=0 npm run prepare:content && vitest run",
    "test:automation": "python -m unittest discover -s tests/python -p \"test_*.py\" -v",
    "test:watch": "vitest",
    "validate:routes": "node scripts/validate-routes.mjs",
    "validate:repeat": "node scripts/validate-repeatability.mjs",
    "setup:browsers": "playwright install chromium firefox webkit",
    "test:browser": "playwright test --project=chromium --project=firefox --project=mobile",
    "test:browser:all": "playwright test",
    "test:browser:webkit": "node scripts/test-webkit.mjs",
    "test:browser:webkit:native": "playwright test --project=webkit",
    "test:lighthouse": "CHROME_PATH=$(node -e \"console.log(require('playwright').chromium.executablePath())\") lhci autorun",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "lint:markdown": "markdownlint README.md SPEC.md 'docs/**/*.md' 'templates/**/*.md'",
    "audit": "node scripts/audit.mjs",
    "validate:core": "npm run format:check && npm run lint:markdown && npm run audit && npm run check && npm run test && npm run test:automation && npm run build && npm run validate:repeat && npm run validate:routes",
    "validate": "npm run setup:browsers && npm run validate:core && npm run test:browser && npm run test:browser:webkit && npm run test:lighthouse",
    "new:post": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.4.2",
    "gray-matter": "4.0.3",
    "markdown-it": "15.0.3",
    "reading-time": "1.5.0",
    "sanitize-html": "2.18.1",
    "yaml": "2.9.1",
    "tinyglobby": "0.2.17"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "proxy-agent": "8.0.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "markdownlint-cli": "0.49.1"
  },
  "overrides": {
    "@puppeteer/browsers": "3.2.0",
    "basic-ftp": "6.2.2",
    "katex": "0.19.0",
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "markdownlint-cli": {
      "js-yaml": "5.4.3",
      "smol-toml": "1.9.1"
    }
  }
}
