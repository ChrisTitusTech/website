# Cloudflare Pages custom HTTP headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers — applied to all pages
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Fingerprinted Astro assets are safe to cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Copied scripts and styles must revalidate
/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# Static assets that don't carry a hash — long TTL but not immutable
/fonts/*
  Cache-Control: public, max-age=31536000

/images/*
  Cache-Control: public, max-age=31536000

/favicon/*
  Cache-Control: public, max-age=31536000

# HTML pages — must revalidate so updates are picked up promptly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# JSON/XML feeds
/index.json
  Cache-Control: public, max-age=3600

/index.xml
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=86400
